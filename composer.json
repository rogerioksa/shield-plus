{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "rogerioksa/shield-plus",
    "type": "library",
    "description": "Shield+ (rogerioksa/shield-plus): ACL por convencao para paineis Filament — conjunto canonico de permissoes descoberto do painel, grants por papel em DSL de escopos, ownership por dados e gerador de policies.",
    "keywords": ["laravel", "filament", "acl", "rbac", "permission"],
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Securyt\\Acl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Securyt\\Acl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Securyt\\Acl\\AclServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit -c phpunit.package.xml"
    }
}